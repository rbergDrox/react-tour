{
    "name": "@shapperize/react-tour",
    "version": "0.1.1",
    "description": "Headless React layer over Driver.js: id-based anchors, tours that span page navigations, step preparers and hints.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rbergDrox/react-tour.git"
    },
    "homepage": "https://github.com/rbergDrox/react-tour#readme",
    "bugs": {
        "url": "https://github.com/rbergDrox/react-tour/issues"
    },
    "type": "module",
    "keywords": [
        "react",
        "tour",
        "product-tour",
        "onboarding",
        "driver.js",
        "hints",
        "inertia"
    ],
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./anchors": {
            "import": {
                "types": "./dist/anchors.d.ts",
                "default": "./dist/anchors.js"
            },
            "require": {
                "types": "./dist/anchors.d.cts",
                "default": "./dist/anchors.cjs"
            }
        },
        "./inertia": {
            "import": {
                "types": "./dist/inertia.d.ts",
                "default": "./dist/inertia.js"
            },
            "require": {
                "types": "./dist/inertia.d.cts",
                "default": "./dist/inertia.cjs"
            }
        },
        "./styles.css": "./dist/styles.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "typecheck:examples": "tsc --noEmit -p examples/react-router && tsc --noEmit -p examples/inertia-react",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test --config e2e/playwright.config.ts",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build -o storybook-static",
        "check:package": "publint && attw --pack . --profile node16 --exclude-entrypoints styles.css",
        "changeset": "changeset",
        "release": "npm run build && changeset publish",
        "examples:install": "npm ci --prefix examples/react-router && npm ci --prefix examples/inertia-react"
    },
    "peerDependencies": {
        "driver.js": "^1.8.0",
        "react": ">=18"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^9.19.0",
        "@playwright/test": "^1.64.0",
        "@storybook/react-vite": "^10.6.2",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.13.5",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.2",
        "driver.js": "^1.9.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^16.0.0",
        "jsdom": "^30.1.2",
        "prettier": "^3.9.10",
        "publint": "^0.3.25",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "storybook": "^10.6.2",
        "tsup": "^8.5.1",
        "typescript": "~5.9.0",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.4"
    }
}
